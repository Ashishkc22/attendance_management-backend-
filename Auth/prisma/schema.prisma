generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolesType {
  ADMIN
  TEACHER
  STUDENT
}

model users {
  id                String    @id @default(uuid())
  first_name        String
  middle_name       String
  last_name         String
  role              RolesType @default(STUDENT)
  email             String    @unique
  password          String?
  is_active         Boolean   @default(false)
  is_email_verified Boolean   @default(false)
  is_2fa_enabled    Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  rolesPermission RolePermission[]
}

model Roles {
  id          String  @id @default(uuid())
  name        String
  description String?

  rolesPermission RolePermission[]
}

model Permissions {
  id          String  @id @default(uuid())
  name        String
  description String?

  rolesPermission RolePermission[]
}

model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String
  user_id       String

  roles       Roles       @relation(fields: [role_id], references: [id])
  permissions Permissions @relation(fields: [permission_id], references: [id])
  users       users       @relation(fields: [user_id], references: [id])

  @@unique([role_id, permission_id, user_id])
}

model clientInfo {
  client_id String @id
  client_name String @unique
  client_secret String @unique
}